{
  "expo": {
    "name": "OrderInventory",
    "slug": "OrderInventory",
    "version": "1.0.0",
    "description": "Company inventory management for imports, approvals, barcode scanning, and audit history.",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "orderinventory",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "buildNumber": "1",
      "config": {
        "usesNonExemptEncryption": false
      },
      "requireFullScreen": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sharing",
      [
        "expo-camera",
        {
          "barcodeScannerEnabled": true,
          "cameraPermission": "Allow OrderInventory to use your camera to scan product barcodes and find inventory items.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-screen-orientation",
        {
          "initialOrientation": "DEFAULT"
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
